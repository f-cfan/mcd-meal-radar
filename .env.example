# 麦麦饭点雷达 · 环境变量示例
#
# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，真实凭证不会进入仓库。
# 也可以直接用系统环境变量，此文件仅作字段说明。

# ---- 麦当劳 MCP ----
# 获取：手机号登录 https://open.mcd.cn/mcp → 控制台 → 激活 → 复制 Token
MCD_MCP_TOKEN=

# ---- SMTP 推送（标准 SMTP，收件邮箱由你自己配置）----
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
# 注意：这里是 SMTP 授权码，不是邮箱登录密码。
# 在邮箱设置中开启 SMTP 服务后生成。
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_SENDER_NAME=麦麦饭点雷达
RADAR_TO=
# 1 = SSL/TLS 直连（默认）；0 = STARTTLS
SMTP_USE_SSL=1

# ---- 推送通道 ----
# agent = Agent Mail（推荐，免授权码）| smtp = 自建 SMTP | auto = 先 Agent 后 SMTP
MAIL_CHANNEL=auto
# 走 Agent Mail 时留空即可，程序会自动从 CLI 读取你的 Agent 邮箱地址
RADAR_TO=

# ---- 外送场景（delivery-query-stores 必填 addressId）----
# 方案 A：直接填 addressId
MCD_ADDRESS_ID=
# 方案 B：留空上面，改填 first 或索引，让程序从地址簿取
# 注意：不会静默取第一条 —— 发到哪个地址需要你显式指定
MCD_ADDRESS_PICK=

# ---- 可选：Agent Mail CLI 路径（当不在 PATH 中时）----
AGENTLY_CLI=
