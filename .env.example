# 麦麦饭点雷达 · 环境变量示例
#
# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，真实凭证不会进入仓库。
# 也可以直接用系统环境变量，此文件仅作字段说明。

# ---- 麦当劳 MCP ----
# 获取：手机号登录 https://open.mcd.cn/mcp → 控制台 → 激活 → 复制 Token
MCD_MCP_TOKEN=

# ---- SMTP 推送（标准 SMTP，收件邮箱由你自己配置）----
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
# 注意：这里是 SMTP 授权码，不是邮箱登录密码。
# 在邮箱设置中开启 SMTP 服务后生成。
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_SENDER_NAME=麦麦饭点雷达
RADAR_TO=
# 1 = SSL/TLS 直连（默认）；0 = STARTTLS
SMTP_USE_SSL=1

# ---- 可选：外送场景 ----
# 外送场景需要先通过 delivery-create-address 建立地址簿，此处填 addressId
MCD_ADDRESS_ID=
