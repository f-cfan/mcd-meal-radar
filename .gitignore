# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 环境变量与密钥 —— 严禁提交
.env
.env.*
!.env.example
mcp-config.json
*.token
secrets/

# 本地数据（含用户偏好画像，属敏感信息）
data/
*.local.json
profile.local.json
state/

# 系统文件
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 运行时产物
#
# ⚠️ 保持忽略：out/ 里的邮件可能含用户偏好画像与地址等敏感信息，
# **不能提交到仓库**。GitHub Pages 的在线预览由 CI 用
# `actions/upload-pages-artifact` 直接上传，不经过 git ——
# 所以这里**不要**为部署去放开 out/ 或 out/preview/。
out/
logs/
data/

# Agent Mail 临时正文文件（正常会被自动清理，此处防御性忽略）
.agently-body-*
